# Copy this file to scripts/.env.local and fill in your key.
# scripts/.env.local is gitignored — never commit real keys.

TOKENROUTER_API_KEY=tr_replace_me

# Base URL as shown in the TokenRouter dashboard.
# .com/v1 is the most common working value for OpenAI-compatible mode.
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Model to test by default (default: gpt-4o).
# Use --sweep on the CLI to test all: gpt-4o, auto:fast, auto:balance, openai:gpt-4o
TOKENROUTER_TEST_MODEL=gpt-4o
