# TokenRouter API settings
# Use the base URL shown in your TokenRouter dashboard.
# .com/v1 is the current working value for openai_chat mode.
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=your-api-key-here

# API mode: openai_chat (default) | native_route | responses
# Run scripts/tokenrouter_smoke.py to find which mode works for your account.
TOKENROUTER_API_MODE=openai_chat

# Set to true to use mock LLM responses (for testing/development without real API calls)
MOCK_LLM=false

# Data directory (relative to backend/ or absolute path)
DATA_DIR=./data

# Logging
LOG_LEVEL=INFO

# HTTP bind (used by python main.py and by backend/dev.ps1 -> UVICORN_* for plain uvicorn)
# Plain `uvicorn main:app` does NOT read API_PORT; use: .\dev.ps1  OR  $env:UVICORN_PORT=8003
API_HOST=0.0.0.0
API_PORT=8003

# CORS origins (comma-separated, or JSON array e.g. ["http://localhost:3000"])
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
